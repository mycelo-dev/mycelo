        },
        {
          "name": "Revoke Current API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/revoke_api_key",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "revoke_api_key"
              ]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "const teamId = pm.collectionVariables.get('team_public_id');",
          "if (teamId) {",
          "  pm.request.headers.upsert({ key: 'X-Mycelo-Team', value: teamId });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "tenant_public_id",
      "value": ""
    },
    {
      "key": "user_public_id",
      "value": ""
    },
    {
      "key": "team_public_id",
      "value": ""
    }
  ]
}
