{
  "info": {
    "name": "Mycelo Local",
    "description": "Local development collection for Mycelo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Stream",
      "item": [
        {
          "name": "Publish Event",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"orders.created\",\n  \"event_data\": {\n    \"order_id\": \"ord_123\",\n    \"status\": \"created\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/publish",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "publish"
              ]
            }
          }
        },
        {
          "name": "Get Events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/events?topic=orders.created&after=0&offset=0&limit=100",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "events"
              ],
              "query": [
                {
                  "key": "topic",
                  "value": "orders.created"
                },
                {
                  "key": "after",
                  "value": "0"
                },
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "100"
                }
              ]
            }
          }
        }
      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{api_key}}",
            "type": "string"
          }
        ]
      }
    },
