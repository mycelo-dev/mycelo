              "path": [
                "create_team"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('team_public_id', response.team_public_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Team API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"team_public_id\": \"{{team_public_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/create_api_key",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "create_api_key"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('api_key', response.api_key);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Rotate Current API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
