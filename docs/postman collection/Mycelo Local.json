    {
      "name": "Account and API Keys",
      "item": [
        {
          "name": "Sign Up Tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenant_name\": \"Acme\",\n  \"user_name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/signup",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "signup"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('tenant_public_id', response.tenant_public_id);",
                  "pm.collectionVariables.set('user_public_id', response.user_public_id);",
                  "pm.collectionVariables.set('team_public_id', response.team_public_id);",
                  "pm.collectionVariables.set('api_key', response.api_key);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Log In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('tenant_public_id', response.tenant_public_id);",
                  "pm.collectionVariables.set('user_public_id', response.user_public_id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Teams",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/teams",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "teams"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (Array.isArray(response) && response[0]?.team_public_id) {",
                  "  pm.collectionVariables.set('team_public_id', response[0].team_public_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Team",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
